{
  "name": "ruijinen-block-patterns-r002-lp",
  "description": "類人猿 LP向けパターン集のパッケージです",
  "author": "mgn",
  "license": "GPL-2.0+",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@wordpress/env": "^12.0.0",
    "backstopjs": "^6.3.25",
    "cssnano": "^9.9.0",
    "del-cli": "^8.0.1",
    "glob": "^14.0.3",
    "npm-run-all2": "^9.0.4",
    "postcss": "^8.5.32",
    "postcss-cli": "^12.0.0",
    "postcss-sort-media-queries": "^6.7.1",
    "postcss-sorting": "^10.0.0",
    "sass": "^1.106.1",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3"
  },
  "scripts": {
    "export:wp-content:themes": "npm run cli cp -- -r wp-content/themes .export/wp-content",
    "export:wp-content:uploads": "npm run cli cp -- -r wp-content/uploads .export/wp-content",
    "export:wp-content": "npm run cli rm -- -rf .export/wp-content && mkdir -p .export/wp-content/uploads && run-p export:wp-content:*",
    "export:db": "mkdir -p .export/sql && npm run wp db -- export .export/sql/local.sql",
    "export": "run-p export:*",
    "import:wp-content:themes": "npm run cli cp -- -r .export/wp-content/themes wp-content",
    "import:wp-content:uploads": "npm run cli cp -- -r .export/wp-content/uploads wp-content",
    "import:wp-content": "run-p import:wp-content:*",
    "import:db": "npm run wp db -- import .export/sql/local.sql",
    "import": "run-p import:*",
    "wp-env": "wp-env",
    "start": "wp-env start && open http://localhost:1021",
    "stop": "npm run export && wp-env stop",
    "cli": "wp-env run cli",
    "wp": "wp-env run cli wp",
    "clean": "run-s \"clean:*\"",
    "clean:all": "del-cli \"dist/css/**\" \"dist/js/**\"",
    "build": "run-s clean \"build:*\"",
    "build:sass": "sass src/css:dist/css block-styles:dist/css/block-styles patterns:dist/css/patterns --no-error-css --no-source-map",
    "build:postcss": "postcss dist/css --base ./dist/css -d dist/css",
    "build:js": "webpack",
    "build:img": "node optimize-images.mjs",
    "debug:css": "sass src/css:dist/css block-styles:dist/css/block-styles patterns:dist/css/patterns",
    "watch": "run-p \"watch:*\"",
    "watch:sass": "sass src/css:dist/css block-styles:dist/css/block-styles patterns:dist/css/patterns --no-error-css --no-source-map --watch",
    "watch:postcss": "postcss dist/css --base ./dist/css -d dist/css --watch",
    "backstop_reference": "npm run backstop reference",
    "backstop_test": "npm run backstop test",
    "backstop_approve": "npm run backstop approve",
    "backstop": "node ./backstop_data/runner.js"
  },
  "browserslist": [
    ">0.25% in JP",
    "not ie < 11",
    "iOS >= 10",
    "Android >= 4.4"
  ],
  "allowScripts": {
    "puppeteer": true,
    "@parcel/watcher": false,
    "fs-ext-extra-prebuilt": false
  }
}
